# Copy to .env and fill in. NEVER commit the real .env.

# PostgreSQL password (used by the db container and in the API's database URL).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Bootstrap administrator token (>= 24 characters). It is only used to set up the server:
# create registries, users and service tokens, then keep it in a secret store.
# Generate: openssl rand -hex 32
OWL_SERVER_ADMIN_TOKEN=

# public | private | mixed  (see the documentation)
OWL_SERVER_MODE=mixed

# Allow password logins for local accounts (create the first one with `owl-server create-admin`).
OWL_SERVER_LOCAL_ACCOUNTS=false

# Port on the host (bound to 127.0.0.1; put a TLS reverse proxy in front of it)
OWL_SERVER_PORT=8765
