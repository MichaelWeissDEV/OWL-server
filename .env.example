# Copy to .env and fill in. NEVER commit the real .env.

# PostgreSQL password (used by the db container and in the API's database URL). Required.
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Access ------------------------------------------------------------------------------------
# By default the server starts OPEN: no login, everyone who can reach it is an administrator. That is
# convenient on localhost or in a trusted network (the port is bound to 127.0.0.1 here). Open the
# dashboard -> Settings -> "Secure this server" to create the first administrator and require logins.
#
# Optional bootstrap token (>= 24 characters). Setting it also secures the server right away.
# Generate: openssl rand -hex 32
OWL_SERVER_ADMIN_TOKEN=
# true = always open, false = always secured, empty = automatic
OWL_SERVER_OPEN=

# public | private | mixed (applies once the server is secured; see the documentation)
OWL_SERVER_MODE=mixed
# Local accounts managed in the dashboard (Argon2id)
OWL_SERVER_LOCAL_ACCOUNTS=true

# Port on the host (bound to 127.0.0.1; put a TLS reverse proxy in front of it)
OWL_SERVER_PORT=8765
# Reverse proxies whose X-Forwarded-* headers are trusted
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Identity providers (all optional; see the documentation) -----------------------------------
# OIDC (Keycloak, Authentik, Entra ID, Okta, ...):
#   OWL_SERVER_OIDC_ISSUER=  OWL_SERVER_OIDC_CLIENT_ID=  OWL_SERVER_OIDC_CLIENT_SECRET=  OWL_SERVER_OIDC_REDIRECT_URI=
# OAuth 2.0 (GitHub preset):  OWL_SERVER_OAUTH_PRESET=github  OWL_SERVER_OAUTH_CLIENT_ID=...  OWL_SERVER_OAUTH_ALLOWED_USERS=alice,bob
# LDAP / Active Directory:    OWL_SERVER_LDAP_URL=ldaps://dc.example.com  OWL_SERVER_LDAP_BIND_DN=...  OWL_SERVER_LDAP_USER_BASE=...
# Proxy auth (Kerberos/SAML):  OWL_SERVER_PROXY_AUTH=true  OWL_SERVER_PROXY_SECRET=...

# Dashboard (optional: docker compose --profile dashboard up -d --build)
OWL_DASHBOARD_PORT=8080

# --- Insecure switches (labs only) -------------------------------------------------------------
# Secure behaviour is the default. Anything that weakens it needs one of these deliberately long
# switches; every active one is logged as a warning. Do NOT set them in production.
#   OWL_SERVER_ALLOW_INSECURE_LDAP_WITHOUT_TLS=true            # plain ldap://, passwords unencrypted
#   OWL_SERVER_ALLOW_INSECURE_OIDC_OVER_HTTP=true
#   OWL_SERVER_ALLOW_INSECURE_OAUTH_OVER_HTTP=true
#   OWL_SERVER_ALLOW_INSECURE_DISABLE_OIDC_TLS_VERIFICATION=true
#   OWL_SERVER_ALLOW_INSECURE_DISABLE_OAUTH_TLS_VERIFICATION=true
#   OWL_SERVER_ALLOW_INSECURE_DISABLE_LDAP_TLS_VERIFICATION=true
